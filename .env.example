# Copy this file to .env, and never commit the copy. docs/ENVIRONMENT_SETUP.md explains each value.
# Values are checked at startup, and error messages name the variable without printing its value.

# --- Required everywhere ---
# Must be a replica set, because Prisma uses transactions. `npm run db:dev` starts a local one.
DATABASE_URL="mongodb://127.0.0.1:27017/muslim?replicaSet=rs0"
# The site's public address, used for canonical links, the sitemap, and the player's origin.
APP_URL="http://localhost:3000"

# --- Sign-in. Required in production; without them locally, sign-in is simply unavailable. ---
# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- YouTube Data API ---
YOUTUBE_API_ENABLED="false"
YOUTUBE_API_KEY=""
# At least 32 characters. Protects the daily refresh endpoint.
CRON_SECRET=""

# --- Image storage: "local" or "s3" ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".data/uploads"
# Only for STORAGE_PROVIDER="s3".
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Only for S3-compatible providers other than AWS.
STORAGE_ENDPOINT=""
# Where readers load images from, such as a CDN address.
STORAGE_PUBLIC_URL=""

# --- Shown on the privacy and terms pages. Fill these in before launch. ---
LEGAL_RESPONSIBLE_NAME=""
LEGAL_CONTACT_EMAIL=""
