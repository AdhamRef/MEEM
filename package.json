{
  "name": "muslim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first Islamic short-form content and knowledge discovery platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:dev": "tsx scripts/database/dev-replica-set.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:indexes": "tsx scripts/database/create-indexes.ts",
    "db:sync": "prisma db push --skip-generate && npm run db:indexes",
    "db:bootstrap-admin": "tsx scripts/database/bootstrap-super-admin.ts",
    "db:seed-taxonomy": "tsx scripts/database/seed-taxonomy.ts",
    "youtube:import-dev": "tsx scripts/youtube/import-videos.ts",
    "verify": "npm run db:validate && npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "prisma generate",
    "check:bundle": "tsx scripts/maintenance/scan-client-bundle.ts",
    "youtube:backfill-shapes": "tsx scripts/youtube/backfill-video-shapes.ts",
    "youtube:backfill-stats": "tsx scripts/youtube/backfill-video-statistics.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "11.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
