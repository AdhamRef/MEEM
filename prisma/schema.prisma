// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model ImportJob {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  type              ImportJobType
  status            ImportJobStatus @default(DISCOVERING)
  channelId         String          @db.ObjectId
  createdById       String?         @db.ObjectId
  /// YouTube pagination token, persisted so a job can resume after an interruption.
  nextPageToken     String?
  discoveredCount   Int             @default(0)
  importedCount     Int             @default(0)
  duplicateCount    Int             @default(0)
  skippedCount      Int             @default(0)
  failedCount       Int             @default(0)
  errors            ImportError[]
  cancelRequestedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  channel    YouTubeChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  candidates ImportCandidate[]

  @@index([status, createdAt])
  @@index([channelId, createdAt])
}

/// A temporary metadata snapshot for review. A TTL index removes it within 30 days.
model ImportCandidate {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  jobId           String                @db.ObjectId
  youtubeVideoId  String
  title           String
  channelTitle    String?
  description     String?
  tags            String[]
  thumbnails      Thumbnail[]
  durationSeconds Int?
  ytPublishedAt   DateTime?
  /// Width divided by height, from the player size YouTube reports.
  aspectRatio     Float?
  /// Comes with the same request, so it costs no extra quota. Expires with the candidate.
  stats           VideoStats?
  isEmbeddable    Boolean               @default(true)
  classification  VideoClassification
  alreadyImported Boolean               @default(false)
  isSelected      Boolean               @default(false)
  assignment      ImportAssignment?
  result          ImportCandidateResult @default(PENDING)
  resultMessage   String?
  createdAt       DateTime              @default(now())
  expiresAt       DateTime

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, youtubeVideoId])
  @@index([jobId, classification, alreadyImported, isSelected])
  @@index([jobId, result])
}

/// Append-only. Never removed automatically (§20.4). actorEmail is a snapshot, so the
/// record stays meaningful after the account changes.
model AuditLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?   @db.ObjectId
  actorEmail String?
  actorRole  UserRole?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model ApplicationSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
}

/// Estimated YouTube quota use for one Pacific-time day, when YouTube resets quota.
model ApiQuotaUsage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  day        String   @unique
  units      Int      @default(0)
  byEndpoint Json?
  exhausted  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model RateLimitBucket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
}

enum SourceDraftKind {
  CHANNEL
  PLAYLIST
  VIDEOS
}

enum SourceDraftStatus {
  WAITING
  PROCESSING
  ADDED
  FAILED
}

/// A source someone wants added later, usually because the day's YouTube quota has run out.
/// Saving one costs no quota: the link is only parsed. Adding it is the same as on Sources.
model SourceDraft {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  /// What the link points at, so the same source can't be queued twice.
  key           String            @unique
  input         String
  kind          SourceDraftKind
  label         String?
  /// Why it's worth adding, for whoever reviews the queue.
  note          String?
  status        SourceDraftStatus @default(WAITING)
  /// Added by the hourly job as soon as there's quota for it.
  autoAdd       Boolean           @default(true)
  attempts      Int               @default(0)
  resultMessage String?
  resultHref    String?
  /// A short lease, so the hourly job and a person pressing the button never add it twice.
  lockedUntil   DateTime?
  createdById   String            @db.ObjectId
  processedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, autoAdd, createdAt])
  @@index([createdAt])
}
